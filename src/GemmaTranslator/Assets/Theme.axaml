<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The accent is NOT a variant and it is not in these dictionaries. Appearance
    writes it into three keys of the resources instead.
  -->

  <!--
    The one alpha of the glass, and each Glass brush below carries it. Thus a
    control gets the glass on its Background and its content stays as bright
    as it was.

    THIS BACKEND HAS NO BLUR OF THE GROUND AND IT CANNOT HAVE ONE.
    ExperimentalAcrylicBorder asks the compositor of the system to blur what is
    behind the WINDOW, and DRM has no compositor and no window. BlurEffect
    blurs the subtree of an element.

    The Avalonia documents also record that a blur of Skia can decrease the
    frame rate from 60 to 30 or less. This panel pays for an offscreen buffer
    and a shader at each frame, because the software turns it 90 degrees.

    Thus translucency and a scrim, and no blur. The 0.5 of the design assumes
    that blur, and with sharp text below sharp text it makes the lanes hard to
    read.
  -->
  <x:Double x:Key="GlassAlpha">0.88</x:Double>

  <ResourceDictionary.ThemeDictionaries>

    <!--
      CAUTION: this Default dictionary is necessary and it is not a copy that
      somebody can remove. Avalonia does not go from Light or Dark to Default,
      and it does not go from Default to either of them. With no Default each
      brush below is null under ThemeVariant.Default, a null Background is
      clear, and the panel of the appliance then shows the framebuffer. There
      is no keyboard to correct that condition.

      The values are the values of Dark.
    -->
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="PageBrush" Color="#141412" />
      <SolidColorBrush x:Key="PanelBrush" Color="#201F1C" />
      <SolidColorBrush x:Key="CardBrush" Color="#242320" />
      <SolidColorBrush x:Key="InkBrush" Color="#FAF9F5" />
      <SolidColorBrush x:Key="MutedBrush" Color="#A3A198" />
      <SolidColorBrush x:Key="HairBrush" Color="#FAF9F5" Opacity="0.24" />
      <SolidColorBrush x:Key="InverseBrush" Color="#F0EDE4" />
      <SolidColorBrush x:Key="InverseInkBrush" Color="#1A1A18" />

      <SolidColorBrush x:Key="GlassBrush" Color="#141412" Opacity="{StaticResource GlassAlpha}" />
      <SolidColorBrush x:Key="GlassEdgeBrush" Color="#FAF9F5" Opacity="0.18" />
      <LinearGradientBrush x:Key="ScrimBrush" StartPoint="0%,0%" EndPoint="0%,100%" Opacity="{StaticResource GlassAlpha}">
        <GradientStop Offset="0" Color="#00141412" />
        <GradientStop Offset="1" Color="#FF141412" />
      </LinearGradientBrush>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="PageBrush" Color="#FAF9F5" />
      <SolidColorBrush x:Key="PanelBrush" Color="#F0EDE4" />
      <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="InkBrush" Color="#1A1A18" />
      <SolidColorBrush x:Key="MutedBrush" Color="#6B6961" />

      <!-- The hair line is not opaque on purpose. It goes on the page, on the
           panel, and on a card, and one opaque grey cannot suit the three. -->
      <SolidColorBrush x:Key="HairBrush" Color="#1A1A18" Opacity="0.22" />

      <SolidColorBrush x:Key="InverseBrush" Color="#1A1A18" />
      <SolidColorBrush x:Key="InverseInkBrush" Color="#FAF9F5" />

      <SolidColorBrush x:Key="GlassBrush" Color="#FAF9F5" Opacity="{StaticResource GlassAlpha}" />
      <SolidColorBrush x:Key="GlassEdgeBrush" Color="#1A1A18" Opacity="0.14" />
      <LinearGradientBrush x:Key="ScrimBrush" StartPoint="0%,0%" EndPoint="0%,100%" Opacity="{StaticResource GlassAlpha}">
        <GradientStop Offset="0" Color="#00FAF9F5" />
        <GradientStop Offset="1" Color="#FFFAF9F5" />
      </LinearGradientBrush>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="PageBrush" Color="#141412" />
      <SolidColorBrush x:Key="PanelBrush" Color="#201F1C" />
      <SolidColorBrush x:Key="CardBrush" Color="#242320" />
      <SolidColorBrush x:Key="InkBrush" Color="#FAF9F5" />
      <SolidColorBrush x:Key="MutedBrush" Color="#A3A198" />
      <SolidColorBrush x:Key="HairBrush" Color="#FAF9F5" Opacity="0.24" />
      <SolidColorBrush x:Key="InverseBrush" Color="#F0EDE4" />
      <SolidColorBrush x:Key="InverseInkBrush" Color="#1A1A18" />

      <SolidColorBrush x:Key="GlassBrush" Color="#141412" Opacity="{StaticResource GlassAlpha}" />
      <SolidColorBrush x:Key="GlassEdgeBrush" Color="#FAF9F5" Opacity="0.18" />
      <LinearGradientBrush x:Key="ScrimBrush" StartPoint="0%,0%" EndPoint="0%,100%" Opacity="{StaticResource GlassAlpha}">
        <GradientStop Offset="0" Color="#00141412" />
        <GradientStop Offset="1" Color="#FF141412" />
      </LinearGradientBrush>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!--
    CAUTION: the colour of a status message and the colour of a warning must
    not follow the accent. A person can select the green accent, and a warning
    in green says the opposite of what it means.
  -->

  <SolidColorBrush x:Key="StatusDotBrush" Color="#D97706" />
  <SolidColorBrush x:Key="RecordingDotBrush" Color="#E5484D" />

  <!-- A part of the appliance that a person must connect again. The colour is
       the colour of the two brushes above it and below it, and the name is
       different because the meaning is different. -->
  <SolidColorBrush x:Key="AlertBrush" Color="#E5484D" />
  <SolidColorBrush x:Key="AlertInkBrush" Color="#FFFFFF" />

  <!-- The charge of the cells: 20 % and less, then 10 % and less. The two
       apply on the cells only. A machine on the mains line shows neither. -->
  <SolidColorBrush x:Key="BatteryWarningBrush" Color="#D97706" />
  <SolidColorBrush x:Key="BatteryDangerBrush" Color="#E5484D" />

  <!-- The screensaver and the warning of the very low charge make their own
       ground. They do not follow the variant. -->
  <SolidColorBrush x:Key="ScreensaverGroundBrush" Color="#0B0B0A" />
  <SolidColorBrush x:Key="ScreensaverInkBrush" Color="#FAF9F5" />
  <SolidColorBrush x:Key="ScreensaverMutedBrush" Color="#6B6A62" />
  <SolidColorBrush x:Key="ScreensaverBatteryBrush" Color="#A8A69E" />

  <SolidColorBrush x:Key="CriticalGroundBrush" Color="#1A1A18" />
  <SolidColorBrush x:Key="CriticalInkBrush" Color="#FAF9F5" />
  <SolidColorBrush x:Key="CriticalMutedBrush" Color="#A8A69E" />

</ResourceDictionary>
