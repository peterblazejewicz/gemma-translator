<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fonts="using:GemmaTranslator.Fonts">

  <!--
    The panel gives 11.6 pixels for one millimetre, thus a control that a
    finger touches needs 105 pixels and the smallest text at the distance of an
    arm is 24 pixels.

    A class here gives no family for the text of a conversation. That family
    comes from the language of the lane. See Fonts/AppFonts.cs.
  -->

  <Style Selector="TextBlock.headline">
    <Setter Property="FontSize" Value="46" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="TextBlock.sub-headline">
    <Setter Property="FontSize" Value="25" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <Style Selector="TextBlock.status">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!-- The view model gives the dimension: 42, and 34 when the text is longer
       than 70 characters. -->
  <Style Selector="TextBlock.conversation">
    <Setter Property="FontSize" Value="42" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <Style Selector="TextBlock.section-label">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="36" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <!--
    This class gives the family and not the dimension. The design uses the same
    face at 22, 26, 34, 44, and 150 pixels.

    "+tnum" gives one width to each numeral. Each font of this software already
    does that.
  -->
  <Style Selector="TextBlock.numeric">
    <Setter Property="FontFamily" Value="{x:Static fonts:AppFonts.MonoFamily}" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

</Styles>
