<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:GemmaTranslator.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GemmaTranslator.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GemmaTranslator.Views.WarmUpView"
             x:DataType="vm:MainViewModel"
             d:DesignWidth="1280"
             d:DesignHeight="720"
             mc:Ignorable="d">

  <UserControl.Styles>
    <!-- The bar of the ProgressBar has its own corner and the control does not
         give it the value of CornerRadius. -->
    <Style Selector="ProgressBar /template/ Border#PART_Indicator">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </UserControl.Styles>

  <Panel Background="{DynamicResource PageBrush}">

    <StackPanel Orientation="Horizontal"
                Spacing="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,24,28,0">
      <controls:BatteryGlyph Width="42"
                             Height="22"
                             VerticalAlignment="Center"
                             Percent="{Binding Battery.Percent}"
                             IsCharging="{Binding Battery.IsCharging}"
                             Stroke="{DynamicResource InkBrush}"
                             Fill="{DynamicResource AccentBrush}"
                             GroundBrush="{DynamicResource PageBrush}" />
      <TextBlock Classes="numeric"
                 Text="{Binding Battery.Text}"
                 FontSize="26"
                 Foreground="{DynamicResource MutedBrush}"
                 VerticalAlignment="Center" />
    </StackPanel>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

      <Image Source="{Binding BrandImage}"
             Stretch="Uniform"
             Width="250"
             HorizontalAlignment="Center" />

      <TextBlock Classes="section-label"
                 Text="STARTING UP"
                 LetterSpacing="3"
                 Margin="0,52,0,0"
                 HorizontalAlignment="Center" />

      <TextBlock Text="{Binding WarmUpText}"
                 FontSize="32"
                 Foreground="{DynamicResource InkBrush}"
                 Margin="0,16,0,0"
                 HorizontalAlignment="Center" />

      <!--
        CAUTION: the bar gives no quantity, and it must not give one. The model
        goes into the memory in a different process. That process gives this
        software no signal, thus a percentage here is a number that nobody
        measured. The design shows one, and a design cannot make a measurement
        that the machine does not supply.

        A bar with no quantity says "wait", which is true. A bar at 43 % says
        that 43 % of the work is complete, which nothing here knows.

        The correct answer is a test of the endpoint before the first
        translation. That is a port and not a new function: upstream has
        testConnectionAPI in frontend/src/utils/api.js, and this fork removed
        it before there was a caller. Put it back with the speech-to-text
        slice, and this bar can then show a true condition.
      -->
      <ProgressBar Width="520"
                   Height="12"
                   MinHeight="12"
                   CornerRadius="6"
                   Margin="0,34,0,0"
                   IsIndeterminate="True"
                   Background="{DynamicResource PanelBrush}"
                   Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center" />
    </StackPanel>

    <!--
      The Moonshine licence conditions make this text necessary, and NOTICE
      records that the user interface shows it. This screen comes at each start,
      thus each user sees it one time for each start of the appliance.
    -->
    <TextBlock Text="{x:Static vm:MainViewModel.Attribution}"
               FontSize="20"
               Foreground="{DynamicResource MutedBrush}"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               Margin="0,0,0,28" />

  </Panel>

</UserControl>
