<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GemmaTranslator.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GemmaTranslator.Views.MainView"
             x:DataType="vm:MainViewModel"
             d:DesignWidth="1280"
             d:DesignHeight="720"
             mc:Ignorable="d">

  <!--
    The skeleton of the user interface, for a landscape surface of 1280 x 720.

    The panel is 720 x 1280 in native portrait. The DRM startup turns it 90
    degrees. See Program.cs and section 4.2 of CLAUDE.md.

    The structure is the structure of the upstream user interface, which
    style.css line 68 calls "hardcoded 480x320 landscape". The heights keep the
    upstream proportion of 320 pixels:

      The response area: 232 upstream, star here, 72.5 % of the height.
      The two lanes:      60 upstream, 135 here, 18.75 % of the height.
      The visualizer:     28 upstream,  63 here,  8.75 % of the height.

    This view has no logic. The touch interaction model is not decided. The 135
    pixels of the lanes give a touch target of approximately 11 mm on the
    panel, which is sufficient for a finger.
  -->

  <Grid RowDefinitions="*,135,63" Background="#000000">

    <!-- The response area, which upstream calls the ResponseDrawer.
         The text scrolls and the button has its own row, because the model has
         no limit on the quantity of tokens. A long answer must not move the
         button off the display: the appliance has no keyboard that can then
         correct the condition. -->
    <Grid Grid.Row="0" Background="#111114" RowDefinitions="*,Auto,Auto">

      <ScrollViewer Grid.Row="0"
                    VerticalScrollBarVisibility="Auto"
                    Margin="40,16">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="18">

          <!-- What the person said. The microphone does not operate, thus the
               view model puts a constant example here. -->
          <!-- The font comes from the language of the lane. Chinese and
               Japanese use the same Han characters with a different correct
               shape, thus a fallback list cannot give the two at the same
               time. See Fonts/AppFonts.cs. -->
          <TextBlock Text="{Binding SourceText}"
                     FontFamily="{Binding SourceFont}"
                     FontSize="36"
                     Opacity="0.55"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     HorizontalAlignment="Center" />

          <!-- The translation, which the LiteRT-LM server makes. -->
          <TextBlock Text="{Binding TranslatedText}"
                     FontFamily="{Binding TranslatedFont}"
                     FontSize="44"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </ScrollViewer>

      <!-- CAUTION: this button is temporary and the audio slice replaces it.
           But the dimension is not temporary. The panel gives 11.6 pixels for
           one millimetre (1280 pixels on 110.4 mm, datasheet page 3), and a
           finger needs 9 mm. Thus 105 pixels is the minimum for each control
           that a person touches. The control that comes after this button
           must keep this number. -->
      <Button Grid.Row="1"
              Content="Translate"
              Command="{Binding TranslateCommand}"
              MinHeight="105"
              MinWidth="260"
              FontSize="18"
              HorizontalAlignment="Center" />

      <!-- The status line shows an error. It must wrap: a message can be long,
           and one line goes off the two sides of the display. -->
      <TextBlock Grid.Row="2"
                 Text="{Binding StatusText}"
                 FontSize="14"
                 Opacity="0.45"
                 TextWrapping="Wrap"
                 MaxLines="3"
                 TextAlignment="Center"
                 Margin="40,10,40,14"
                 HorizontalAlignment="Center" />

      <!-- The attribution that the Moonshine licence conditions make
           necessary. It is a fixed part of the layout, not a late addition. -->
      <TextBlock Text="{x:Static vm:MainViewModel.Attribution}"
                 FontSize="12"
                 Opacity="0.45"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="14" />
    </Grid>

    <!-- The two lanes, beside each other, as upstream has them. Each lane is
         one half of the width. Lane 1 is the person on the left. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*">

      <Border Grid.Column="0"
              BorderBrush="#333338"
              BorderThickness="0,1,1,0">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="6">
          <TextBlock Text="1"
                     FontSize="14"
                     Opacity="0.45"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Lane1Language.Name}"
                     FontSize="28"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1"
              BorderBrush="#333338"
              BorderThickness="0,1,0,0">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="6">
          <TextBlock Text="2"
                     FontSize="14"
                     Opacity="0.45"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Lane2Language.Name}"
                     FontSize="28"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

    </Grid>

    <!-- The visualizer. Upstream draws 32 bars from the Web Audio
         AnalyserNode. Avalonia has no AnalyserNode, thus this part needs an
         FFT that we write. It is empty until then. -->
    <Border Grid.Row="2"
            BorderBrush="#333338"
            BorderThickness="0,1,0,0">
      <TextBlock Text="visualizer"
                 FontSize="12"
                 Opacity="0.3"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Border>

  </Grid>

</UserControl>
