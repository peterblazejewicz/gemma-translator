<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:GemmaTranslator.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GemmaTranslator.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GemmaTranslator.Views.ScreensaverView"
             x:DataType="vm:MainViewModel"
             d:DesignWidth="1280"
             d:DesignHeight="720"
             mc:Ignorable="d">

  <UserControl.Styles>
    <!--
      RenderTransform stays at none. The Fluent theme makes the button
      smaller while a finger is on it, and that moves all of this screen.
    -->
    <Style Selector="Button.wake">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.wake:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.wake:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.wake:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
  </UserControl.Styles>

  <Panel Background="{DynamicResource ScreensaverGroundBrush}">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

      <TextBlock Classes="numeric"
                 Text="{Binding Clock}"
                 FontSize="150"
                 LetterSpacing="6"
                 Foreground="{DynamicResource ScreensaverInkBrush}"
                 HorizontalAlignment="Center" />

      <StackPanel Orientation="Horizontal"
                  Spacing="12"
                  Margin="0,22,0,0"
                  HorizontalAlignment="Center">
        <controls:BatteryGlyph Width="42"
                               Height="22"
                               VerticalAlignment="Center"
                               Percent="{Binding Battery.Percent}"
                               IsCharging="{Binding Battery.IsCharging}"
                               Stroke="{DynamicResource ScreensaverMutedBrush}"
                               Fill="{DynamicResource ScreensaverBatteryBrush}"
                               GroundBrush="{DynamicResource ScreensaverGroundBrush}" />
        <TextBlock Classes="numeric"
                   Text="{Binding Battery.Text}"
                   FontSize="24"
                   Foreground="{DynamicResource ScreensaverBatteryBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Text="TOUCH OR PRESS TO WAKE"
                 FontSize="22"
                 LetterSpacing="3"
                 Margin="0,60,0,0"
                 Foreground="{DynamicResource ScreensaverMutedBrush}"
                 HorizontalAlignment="Center" />
    </StackPanel>

    <Path Data="{StaticResource BrandMarkGeometry}"
          Stretch="Uniform"
          Width="200"
          Fill="{DynamicResource ScreensaverMutedBrush}"
          HorizontalAlignment="Center"
          VerticalAlignment="Bottom"
          Margin="0,0,0,44" />

    <!--
      The button comes after the other children, thus it is above them and it
      gets each touch. A TextBlock takes a touch on its full area although it
      has no ground, thus a button below the clock does not get a touch on
      the clock.
    -->
    <Button Classes="wake" Command="{Binding WakeCommand}" />
  </Panel>

</UserControl>
