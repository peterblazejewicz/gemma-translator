<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GemmaTranslator - the Avalonia replacement for the React user interface.

    One project holds the two heads of the software:
      - Windows, with a window (IClassicDesktopStyleApplicationLifetime).
      - The Raspberry Pi, with the Linux DRM backend and one view
        (ISingleViewApplicationLifetime). Start it with the DRM argument.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GemmaTranslator</RootNamespace>
    <AssemblyName>GemmaTranslator</AssemblyName>

    <!-- The two runtime identifiers of this fork. macOS is not a target. -->
    <RuntimeIdentifiers>win-x64;linux-arm64</RuntimeIdentifiers>

    <!-- LibraryImport makes the interop of Services/Speech/Native. The source
         generator writes unsafe code, thus this is not a decision about our
         own code: without it the generator does not compile. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />

    <!-- The DRM output for the Raspberry Pi. The package is managed code, so
         it restores and builds on Windows. It operates on Linux only. -->
    <PackageReference Include="Avalonia.LinuxFramebuffer" Version="12.1.1" />

    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- The audio capture. SoundFlow is a managed layer on miniaudio (MIT).
         miniaudio converts the format in native code, thus the software asks
         for 16 kHz mono F32 and writes no resampler. The package holds the
         native library for win-x64 and for linux-arm64. -->
    <PackageReference Include="SoundFlow" Version="1.4.1" />

    <!--
      The reader of the SVG of the brand mark. See Services/Branding/.

      CAUTION: this version is pinned and it must not move to 5.2.0 or above
      until Avalonia moves to SkiaSharp 4. Svg.Skia 5.1.1 asks for SkiaSharp
      3.119.2 and Avalonia.Skia 12.1.1 asks for 3.119.4, thus NuGet takes
      3.119.4 and the two agree. Svg.Skia 5.2.0 asks for SkiaSharp 4.148.0,
      which would replace the library that draws the panel and shapes the text
      of six languages.

      This is the core package and not Avalonia.Svg.Skia, whose last version is
      11.3.0 and which cannot operate with Avalonia 12.
    -->
    <PackageReference Include="Svg.Skia" Version="5.1.1" />

    <!-- The dependency injection container. See ServiceRegistration.cs. The
         software uses the container only. It does not use the generic host,
         because Avalonia has its own lifetime. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />

    <!-- IConfiguration. The appliance has no keyboard, thus the settings come
         from appsettings.json and from the environment. The environment lets
         the systemd unit change a value with no change to a file. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />

    <!-- The options pattern. It binds a section to a class and examines the
         values at the start. See Configuration/LiteRtOptions.cs. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />

    <!-- IHttpClientFactory, for the calls to the LiteRT-LM server. The factory
         controls the life of the handler. A new HttpClient for each call makes
         the sockets go away slowly and the software then stops. See
         Services/Translation/LiteRtTranslator.cs. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />

    <!-- ILogger. Abstractions holds the [LoggerMessage] source generator, thus
         it is a direct reference and not a transitive one.
         Console goes to journald on the Raspberry Pi. Debug goes to the
         output window of the IDE, because a WinExe on Windows has no
         console. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- The settings must be beside the binary, also in a published folder. -->
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The fonts go in the assembly. Raspberry Pi OS Lite can have no font for
      Arabic and none for Chinese, Japanese, or Korean, and Avalonia then
      throws at the start. See Fonts/GemmaFontCollection.cs.

      The glob takes the font files only. EmbeddedFontCollection reads each
      file of the directory, thus OFL.txt must not go in it.
    -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\Fonts\*.otf" />

    <!-- The licence of the fonts goes beside the binary, as the SIL Open Font
         License makes necessary. -->
    <Content Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The brand mark. deploy/assets/ holds each asset of the brand, because the
      images of the start and the stop are there and deploy-pi.sh takes them
      from that one location. These two go beside the binary instead of in the
      assembly, so that a person can put a mark on an appliance that operates
      and restart it, with no build.

      The branded file is a glob because git does not hold it. See .gitignore.
    -->
    <Content Include="..\..\deploy\assets\brand-mark.svg"
             Link="Assets\brand-mark.svg"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\deploy\assets\branded\brand-mark.svg"
             Link="Assets\branded\brand-mark.svg"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
